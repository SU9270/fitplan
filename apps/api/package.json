{
  "name": "@fitplan/api",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply fitplan --local",
    "db:migrate:remote": "wrangler d1 migrations apply fitplan --remote",
    "invite:create": "node scripts/create-invite.ts"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.14",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.9",
    "@cloudflare/workers-types": "5.20261027.1",
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.154.0"
  }
}
