# FitPlan API base URL (the Cloudflare Worker; `pnpm --filter @fitplan/api dev` serves it on :8787).
# Copy to `.env` and adjust. Expo inlines EXPO_PUBLIC_* at bundle time — restart `expo start` after changing.
#   iOS simulator:     http://localhost:8787 (default)
#   Android emulator:  http://10.0.2.2:8787  (the emulator's alias for your computer)
#   Physical device:   http://<your computer's LAN IP>:8787
EXPO_PUBLIC_API_URL=http://localhost:8787
